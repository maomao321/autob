[Unit]
Description=AutoQuant trading backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=autoquant
WorkingDirectory=/opt/autoquant
Environment=AUTOQUANT_HOST=127.0.0.1
Environment=AUTOQUANT_PORT=8765
EnvironmentFile=/etc/autoquant/autoquant.env
ExecStart=/opt/autoquant/.venv/bin/python -m autoquant_backend
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
